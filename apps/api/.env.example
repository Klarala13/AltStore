PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Supabase — get from: supabase.com > project > settings > database
# Use the "Transaction pooler" URL for DATABASE_URL (port 6543)
# Use the "Direct connection" URL for DIRECT_URL (port 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=change-me

# Shared secret for internal Next.js → NestJS calls
INTERNAL_API_KEY=change-me

# Storage driver: supabase (default) | r2
STORAGE_DRIVER=supabase

# Supabase Storage (recommended for MVP)
# Get values from: supabase.com > project settings > API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=apks

# Cloudflare R2 — get from: dash.cloudflare.com > R2 > Manage API tokens
CF_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=altstore-apks

# VirusTotal — get from: virustotal.com > profile > API key
# Free tier: 4 lookups/min, 500 analyses/day
VT_API_KEY=your-virustotal-api-key

# Redis — for the Bull async scan queue.
# Sin Redis alcanzable, subir un APK se cuelga en "Uploading… 100%".
#
# Opcion A (recomendada): Redis de Railway, en el mismo proyecto que el API.
#   No hay cuenta nueva, ni limite de comandos, ni coste de salida.
#   En el servicio del API, con variables de referencia:
#     REDIS_HOST=${{Redis.REDISHOST}}
#     REDIS_PORT=${{Redis.REDISPORT}}
#     REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
#   Sin REDIS_TLS: la red privada de Railway no lo usa.
#
# Opcion B: Upstash. Plan gratis de 10.000 comandos/dia — justo, porque un
#   worker de Bull consulta Redis aunque no haya trabajo. Necesita REDIS_TLS.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_TLS=true                    # obligatorio en Upstash, no en Railway

# Cuantos reintentos aguanta un comando antes de fallar. Sin tope, una subida
# se queda colgada para siempre en vez de dar error.
# REDIS_MAX_RETRIES_PER_REQUEST=3
# REDIS_CONNECT_TIMEOUT_MS=10000

# Familia de IP al resolver el host: 0 pide A y AAAA, 4 solo IPv4, 6 solo IPv6.
# Se deja en 0 porque la red privada de Railway es solo IPv6.
# REDIS_FAMILY=0

# GDPR: monthly rotating salt for IP hashing (SHA-256)
# Rotate this value each month; store old values for log lookups if needed
# Generate with: openssl rand -hex 32
IP_HASH_SALT=change-me-monthly

# Seed fixture metadata (optional; useful for production-like seed)
# File must exist in your configured R2 bucket under this key
SEED_APK_FILE_KEY=apps/com.altstore.tictactoe80s/1.0.0/TicTacToe80s.apk
SEED_APK_FILE_SIZE=60807176
SEED_APK_SHA256=0c2abd632095dcf39209911deff44ee84278956edcae95da102645f5ad35e1c4
