NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Google OAuth — create at console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — create at github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple OAuth (Sign in with Apple)
# APPLE_ID: Services ID (client id), e.g. com.altstore.web
# APPLE_SECRET: generated client secret JWT
APPLE_ID=
APPLE_SECRET=

# NestJS API URL (internal — not exposed to browser)
API_URL=http://localhost:3001

# Shared secret for internal Next.js → NestJS calls
INTERNAL_API_KEY=change-me
